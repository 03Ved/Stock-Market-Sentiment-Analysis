REDDIT_USER_AGENT=market_sentiment_academic/0.1
DB_PATH=./market_sentiment.db
# MarketAux API key — get from https://www.marketaux.com/
MARKETAUX_API_KEY=

# Google Gemini API key for chatbot — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GNews API key (optional, free tier 100 req/day) — get from https://gnews.io/
GNEWS_API_KEY=

# Optional assistant model
GEMINI_MODEL=gemini-3.8-flash
# Leave empty for standalone Streamlit
API_BASE_URL=
